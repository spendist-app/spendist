    "eslint-plugin-playwright": "^1.8.3",
    "gray-matter": "^4.0.3",
    "jiti": "2.6.1",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.4.2",
    "marked": "^18.0.7",
    "postcss": "^8.5.6",
    "prettier": "^2.8.8",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.34.5",
    "supabase": "^2.70.5",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
