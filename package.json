    "@ng-icons/bootstrap-icons": "^32.5.0",
    "@ng-icons/core": "^32.5.0",
    "@ng-icons/heroicons": "^32.5.0",
    "@ngneat/transloco": "^6.0.4",
    "@supabase/supabase-js": "^2.89.0",
    "express": "^4.22.1",
    "helmet": "^8.2.0",
