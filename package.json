    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^4.17.25",
    "@types/node": "20.19.27",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/utils": "^8.50.1",
    "@vitest/coverage-v8": "4.0.16",
