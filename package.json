    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^4.17.25",
    "@types/node": "20.19.27",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/utils": "8.67.0",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "4.0.16",
    "angular-eslint": "22.1.0",
