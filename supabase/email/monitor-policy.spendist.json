{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSesAccount",
      "Effect": "Allow",
      "Action": "ses:GetAccount",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "OnlySpendistAlertTopic",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:eu-north-1:170638969015:spendist-email-alerts",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}
