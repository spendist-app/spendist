{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlySpendistSendEmail",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:REPLACE_REGION:REPLACE_ACCOUNT_ID:identity/spendist.app",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": ["noreply@spendist.app", "hello@spendist.app"],
          "aws:RequestedRegion": "REPLACE_REGION"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}
